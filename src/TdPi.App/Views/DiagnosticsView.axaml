<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TdPi.App.ViewModels"
             x:Class="TdPi.App.Views.DiagnosticsView"
             x:DataType="vm:DiagnosticsViewModel">

    <ScrollViewer>
        <StackPanel Margin="20" Spacing="12">
            <TextBlock Text="⚙️ 诊断与环境" Classes="pageTitle"/>

            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Text="环境" Classes="sectionTitle"/>
                    <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="pi 可执行文件" Opacity="0.6"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PiPath}" FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="pi 版本" Opacity="0.6"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PiVersion}" FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="agent 目录" Opacity="0.6"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AgentDir}" FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="node" Opacity="0.6"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding NodePath}" FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="终端" Opacity="0.6"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Terminal}" FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="应用数据" Opacity="0.6"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding AppData}" FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="📂 打开 agent 目录" Command="{Binding OpenAgentDirCommand}" Classes="ghost"/>
                        <Button Content="⬆ 更新 pi 本体" Command="{Binding UpdatePiCommand}" Classes="ghost"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Text="td-pi 预设扩展(td-pi-preset)" Classes="sectionTitle"/>
                    <TextBlock Text="该扩展负责把预设注入 pi(系统提示词 + 上下文消息),并在 --continue/--session 恢复会话时延续预设。预设仅经管理器「▶ 启动预设」页启动时生效。由管理器部署到 ~/.pi/agent/extensions/td-pi-preset/。"
                               Opacity="0.6" FontSize="12" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Classes="badge" Classes.badge-on="{Binding ExtensionInstalled}"
                                Classes.badge-off="{Binding !ExtensionInstalled}">
                            <TextBlock Text="{Binding ExtensionInstalled, Converter={x:Static vm:Converters.BoolToOnOff}}"/>
                        </Border>
                        <TextBlock Text="{Binding ExtensionStatus}" VerticalAlignment="Center"/>
                        <Button Content="📥 安装/更新扩展" Command="{Binding DeployExtensionCommand}" Classes="primary"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Text="有 pi 会话记录的项目" Classes="sectionTitle"/>
                    <ItemsControl ItemsSource="{Binding KnownProjects}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" FontSize="12" Opacity="0.8" Margin="0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBox Text="{Binding CliOutput, Mode=OneWay}" Classes="code" IsReadOnly="True"
                     MinHeight="60" MaxHeight="200" AcceptsReturn="True"
                     IsVisible="{Binding HasCliOutput}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
